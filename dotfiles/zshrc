# Lines configured by zsh-newuser-install
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000

setopt autocd
setopt appendhistory
setopt PROMPT_SUBST

bindkey -e
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/$USER/.zshrc'

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh
source ~/.local/share/zsh/plugins/zsh-shift-select/zsh-shift-select.plugin.zsh

bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[[3~" delete-char
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word

alias ls='eza --icons --color=auto'
alias ll='ls -lh'
alias cte='chmod 755'
alias grep='grep --color=auto'

preexec() {
	printf "\n"

    TIME_START=$(date +"%s%3N")

}

precmd() {

    RET_CODE=$?

    local delta hours minutes seconds milisecs

    TIME_END=$(date +"%s%3N")
    [ -z $TIME_START ] && delta=0 || delta=$((TIME_END - TIME_START))

    # Time calculations
    while true; do

        if [ $delta -ge 3600000 ]; then
            hours=$((delta / 3600000))
            delta=$((delta - 3600000))

        elif [ $delta -ge 60000 ]; then
            minutes=$((delta / 60000))
            delta=$((delta - 60000))

        elif [ $delta -ge 1000 ]; then
            seconds=$((delta / 1000))
            delta=$((delta - 1000))

        else
            milisecs=$delta
            delta=0

        fi

        if [ $delta -eq 0 ]; then
            break

        fi

    done

    # Time display
    if [ -z $TIME_START ]; then
        TIME_MODULE="%F{255}%K{#5f5c63} \ue384 init %f%k"

    elif [ -z $seconds ]; then
        TIME_MODULE="%F{255}%K{#5f5c63} \ue384 ${milisecs}ms %f%k"

    elif [ -z $minutes ]; then
        TIME_MODULE="%F{255}%K{#5f5c63} \ue384 ${seconds}s %f%k"

    elif [ -z $hours ]; then
        TIME_MODULE="%F{255}%K{#5f5c63} \ue384 ${minutes}m ${seconds}s %f%k"

    else
        TIME_MODULE="%F{255}%K{#5f5c63} \ue384 ${hours}h ${minutes}m ${seconds}s %f%k"

    fi

    # python virtual environment display
    if [ -z $VIRTUAL_ENV_PROMPT ]; then
        VENV_MODULE="%F{#eeb8cb}\ue0bc%f"

    else
        VENV_MODULE="%F{#eeb8cb}%K{#cac3dc}\ue0bc%f%k%F{#48454e}%K{#cac3dc} \ue73c $VIRTUAL_ENV_PROMPT %f%k%F{#cac3dc}\ue0bc%f"

    fi

    # command success and fail display
    if [ $RET_CODE -eq 0 ]; then
        CMD_MODULE="%F{#5f5c63}%K{#f4eff7}\ue0bc%f%k%F{000}%K{#f4eff7} %% %f%k%F{#f4eff7}\ue0b0%f"

    else
        CMD_MODULE="%F{#5f5c63}%K{#48454e}\ue0bc%f%k%F{255}%K{#48454e} %% %f%k%F{#48454e}\ue0b0%f"

    fi

    PROMPT=$'\n%F{#33275e}%K{#ccbeff} \uf015 %n@%M %f%k%F{#ccbeff}%K{#eeb8cb}\ue0bc%f%k%F{#492534}%K{#eeb8cb} %(3~|.../%2~|%~) %f%k$(echo -ne $VENV_MODULE) \n$(echo -ne $TIME_MODULE)$(echo -ne $CMD_MODULE) '

}

if [ -z "$XDG_CURRENT_DESKTOP" ]; then
	export QT_QPA_PLATFORMTHEME=qt6ct

fi

autoload -Uz compinit
compinit
