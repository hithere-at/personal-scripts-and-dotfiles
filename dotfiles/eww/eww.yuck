(defwindow example :monitor 0
                   :geometry (geometry :x "12px"
                                       :y "-60px"
                                       :width "300px"
                                       :height "70px"
                                       :anchor "bottom left")
                   :stacking "fg"
                   :wm-ignore true
(power-widget))

(defwidget power-widget []
    (box :orientation "h" :space-evenly true :spacing "3px"
        (box :orientation "h" :halign "center"
            (button :onclick "notify-send 'Testing' 'it works'"
                ""
            )
         )        

        (box :orientation "h" :halign "center"
            (button :onclick "notify-send 'Testing' 'it works'"
                "what"
            )
         )
    )
)
