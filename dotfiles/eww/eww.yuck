(defpoll time_hour :interval "1s" "date +'%I'")
(defpoll time_minute :interval "1s" "date +'%M'")
(defpoll time_date :interval "1s" "date +'%d/%m'")

(defpoll bat_icon :interval "1s" "./poller/battery icon")

(defpoll vol_icon :interval "1s" "./poller/volume icon")
(defpoll vol_percent :interval "1s" "./poller/volume percent")

(defpoll bright_icon :interval "1s" "./poller/backlight icon")
(defpoll bright_percent :interval "1s" "./poller/backlight percent")

(defwindow bar-window :monitor 0
                      :geometry (geometry :x "8px"
                                          :width "65px"
                                          :height "752px"
                                          :anchor "left center")
                      :reserve (struts :distance "82px"
                                       :side "left")
                      :wm-ignore false
                      :windowtype "dock"

(bar-widget))

(defwidget bar-widget []

    (box :class "bar_widget"
         :orientation "v"
         :space-evenly true
         :vexpand false
         :hexpand false

         (top-widget)
         (bottom-widget)

    )

)

(defwidget top-widget []

    (box :orientation "v"
         :space-evenly false
         :valign "start"
         
         (launcher-widget)
         (workspace-widget)

    )

)

(defwidget bottom-widget []

    (box :space-evenly false
         :spacing 0
         :orientation "v"
         :valign "end"

         (health-widget)
         (system-widget)
         (clock-widget)
         (power-widget)

    )

)

(defwidget launcher-widget []

    (box :class "launcher_widget"
         :spacing 0
         :space-evenly true
         :width 54
         :height 54

         (button :onclick "rofi -show drun" 
                 :class "launcher_button"
                 :timeout "1m"
                 :tooltip "Launch an app"

                 "󰣇"

         )

    )

)

(deflisten workspace "./poller/workspace")
(defwidget workspace-widget []
    (literal :content workspace)
)

(defwidget health-widget []

    (box :class "health_widget"
         :spacing 0
         :height 54

         (button :class "health_button"
                 :onclick "./handler/health_stat"
                 :timeout "1m"
                 :tooltip "Show system health"
                 "󰍛"

         )

    )

)

(defwidget power-widget []

    (box :class "power_widget"
         :spacing 0
         :space-evenly true
         :width 54
         :height 54

         (button :onclick "eww -c ./main_widget open powermenu-window"
                 :class "power_button"
                 :tooltip "This is a power button"
                 :timeout "1m"
                 "󰐥"

         )

    )

)

(defwidget clock-widget []

    (box :class "clock_widget"
         :orientation "v"
         :space-evenly true
         :spacing -25
         :height 100

         (label :text "${time_hour}")
         (label :text "${time_minute}")
         (label :text "${time_date}" :class "date_label")

    )

)

(defwidget system-widget []

    (box :class "system_widget"
         :orientation "v"
         :space-evenly true
         :spacing 0
         :height 150

         (button :class "battery_button"
                 :onclick "./handler/battery_stat"
                 :timeout "5s"
                 :tooltip "Battery: ${EWW_BATTERY["BAT0"].capacity}%"
                 "${bat_icon}"

         )

         (button :class "volume_button"
                 :onclick "./handler/volume_stat"
                 :timeout "5s"
                 :tooltip "Volume: ${vol_percent}%"
                 "${vol_icon}"

         )

         (button :class "backlight_button"
                 :onclick "./handler/backlight_stat"
                 :timeout "5s"
                 :tooltip "Brightness: ${bright_percent}%"
                 "${bright_icon}"

         )

    )

) 

