#!/bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &
pgrep -x redshift > /dev/null || redshift -l 1:1 -t 5000:5000 -r -g 0.80 &
polybar -c ~/.config/polybar/config.ini &

bspc monitor -d 1 2 3 4 5 6

bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a mpv state=floating
bspc rule -a mpv state=floating

bspc config focused_border_color "#E7DEFF"
bspc config normal_border_color "#312F35"

export QT_QPA_PLATFORMTHEME=qt6ct

~/.config/bspwm/errwatch &
~/.config/bspwm/ramwatch &
~/.config/bspwm/swapwatch &

xinput set-prop "$(xinput list | grep Touchpad | grep -o 'id=[^[]*' | sed 's/[^0-9]*//g')" "libinput Tapping Enabled" 1 &
vibrant-cli eDP-1 1.3 &

feh --bg-fill ~/Pictures/wallpapers/deidey_cuteee.jpg
/usr/lib/polkit-kde-authentication-agent-1 &
picom -b
dunst &
/usr/bin/kdeconnectd &
